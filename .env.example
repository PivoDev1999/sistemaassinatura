CADASTRAMENTO_PORT=3001
PAGAMENTOS_PORT=3002
ASSINATURAS_VALIDAS_PORT=3003

# Postgres (docker compose). Troque a senha no seu .env local.
POSTGRES_USER=assinaturas
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5433

# ServicoCadastramento
CADASTRAMENTO_DATABASE_URL=postgresql://assinaturas:troque-esta-senha@127.0.0.1:5433/cadastro
# Seed: usuario unico do sistema (a senha vira hash bcrypt; nunca vai para o codigo)
SEED_USUARIO=admin
SEED_SENHA=troque-esta-senha
